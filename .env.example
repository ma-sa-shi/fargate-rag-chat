# ローカル開発用の環境変数テンプレート。
# リポジトリルートの`.env`にコピーして実際の値を入れる。
# backend・frontend・rdbがDocker Compose経由で共有する。`.env`はコミットしない。

# --- MySQL(docker-compose.ymlのサービス名は`rdb`) ---
MYSQL_HOST=rdb
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ai_app
MYSQL_USER=app_user
MYSQL_PASSWORD=change-me-password
# アプリコードからは読まれない。ツール互換のために残している。
DATABASE_URL=mysql://app_user:change-me-password@rdb:3306/ai_app

# --- 認証 ---
JWT_SECRET=change-me-long-random-string

# --- Chromaの永続化先(backend)。本番はEFS上の`/data/chromadb`。 ---
PERSIST_DIRECTORY=./chroma_db

# --- 外部API(Embedding / rerank / チャットに必要)。キーが無効でもUvicornの起動自体は
# 成功する。OpenAIのキーは`/api/system/chroma-test`が検索クエリのEmbeddingを生成する
# 時点で検証され、Cohereのキーはチャットがリランカーに到達するまで検証されない。 ---
OPENAI_API_KEY=sk-your-openai-key
COHERE_API_KEY=your-cohere-key

# --- Next.jsのServer Actions / Route HandlerがFastAPIを呼ぶ先 ---
FASTAPI_URL=http://backend:8000/api

# --- backendの任意設定。すべて`src/backend/config.py`に既定値があり、
# 上書きしたい場合のみ設定する。 ---
# ENV=dev                                        # `prod`にするとログレベルがINFOになる
# OPENAI_MODEL_NAME=gpt-5-nano
# OPENAI_EMBEDDING_MODEL_NAME=text-embedding-3-small
# COHERE_MODEL_NAME=rerank-v3.5
# CHARSET=utf8mb4
# BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- デプロイ時のみ使う。ローカルでは不要で、本番ではECSのタスク定義が注入する。
# 未設定ならフロントエンドはローカル動作にフォールバックする。 ---
# APP_ENV=local              # `cloud`にするとアップロード先がpublic/uploadsからS3に変わる
# S3_BUCKET_NAME=            # APP_ENV=cloudのとき必須
# AWS_REGION=ap-northeast-1  # S3クライアントのリージョン。既定はap-northeast-1

# NODE_ENVはNext.jsが自動で設定するため、このファイルには書かない。`next dev`で
# development、`next build` / `next start`でproductionになり、`session_token`クッキーの
# secure属性とログ出力の切り替えに使われる。
